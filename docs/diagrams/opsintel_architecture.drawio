        </mxCell>
        <mxCell id="5 s51" value="Defence in depth: one SQL query from the model" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1220" y="85" width="440" height="22" as="geometry" />
        </mxCell>
        <mxCell id="5 s52" value="&lt;b&gt;1  Statement shape&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;single SELECT / WITH only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1220" y="120" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5 s53" value="&lt;b&gt;2  Read-only connection&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;mode=ro · PRAGMA query_only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1228" y="220" width="424" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5 s55" value="&lt;b&gt;3  SQLite authorizer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;role tables · PII columns denied · function allow-list · no PRAGMA/ATTACH&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1236" y="320" width="408" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5 s57" value="&lt;b&gt;4  Resource limits&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;3 s timeout · 200-row cap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1244" y="420" width="392" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5 s59" value="&lt;b&gt;5  Output masking&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;e-mail / phone regex&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1252" y="520" width="376" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5 s61" value="&lt;b&gt;6  Injection screen&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;instruction-like text withheld&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1260" y="620" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5 s63" value="&lt;b&gt;7  Evidence + audit&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;E# registered · tool.call logged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1268" y="720" width="344" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5 s65" value="Tested by 12 SQL attack cases (DELETE, stacked statements, PII columns via CTE, sqlite_master, PRAGMA, ATTACH, load_extension, runaway recursion) in tests/test_security.py." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="1220" y="830" width="440" height="60" as="geometry" />
        </mxCell>
      </root>
