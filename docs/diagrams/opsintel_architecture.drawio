        <mxCell id="9 e1" value="Research evaluation design" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontSize=22;align=left;verticalAlign=top;fontColor=#1a1a1a;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="30" y="14" width="1640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="9 e2" value="Same 28 questions under three conditions; ground truth computed independently from the generator's truth tables." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontSize=12;align=left;verticalAlign=top;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="30" y="46" width="1640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="9 e3" value="&lt;b&gt;Synthetic generator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;seed 42 · planted signals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="30" y="110" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9 e4" value="&lt;b&gt;Truth tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;clean, pre-corruption&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="30" y="240" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="9 e5" value="&lt;b&gt;Raw sources&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;with injected defects&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="330" y="110" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9 e6" value="&lt;b&gt;ETL pipeline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="330" y="240" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9 e7" value="&lt;b&gt;Operational store&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="330" y="370" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="9 e8" value="&lt;b&gt;Independent ground truth&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;pandas, not the platform's SQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="30" y="380" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9 e9" value="&lt;b&gt;ETL reconciliation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;record &amp; field accuracy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="30" y="520" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9 e10" value="&lt;b&gt;Benchmark (28 questions)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;12 numeric / entity&lt;br&gt;5 retrieval + citation&lt;br&gt;5 should-abstain&lt;br&gt;6 security / governance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;fontSize=12;align=left;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="660" y="110" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="9 e11" value="&lt;b&gt;Targets fixed before testing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;accuracy ≥ 0.95 · citation ≥ 0.90&lt;br&gt;abstention ≥ 0.90 · false abstention ≤ 0.10&lt;br&gt;security = 1.0 · grounding ≥ 0.98&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontSize=12;align=left;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1010" y="110" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="9 e12" value="&lt;b&gt;C1 Analytics-only&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;rules engine · no LLM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="660" y="330" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9 e13" value="&lt;b&gt;C2 Hybrid AI&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Claude + tools + guarded SQL + RAG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="990" y="330" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9 e14" value="&lt;b&gt;C3 LLM-only&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;same model · no tools or data&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontSize=12;align=center;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1320" y="330" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="9 e15" value="&lt;b&gt;Scoring per answer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;numbers within tolerance · entities · cited doc retrieved AND named · abstained? · not_contains (PII, injected text) · DB post-conditions (no approvals, no deletes) · grounding · latency · tokens&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;fontSize=12;align=left;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="660" y="480" width="960" height="90" as="geometry" />
        </mxCell>
        <mxCell id="9 e16" value="&lt;b&gt;Results (one run each, Claude Opus 5.5)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Deterministic accuracy: C1 0.833 · C2 1.0 · C3 0.0&lt;br&gt;Citation accuracy: C1 1.0 · C2 1.0 · C3 0.0&lt;br&gt;False abstention: C1 0.0 · C2 0.0 · C3 0.824&lt;br&gt;Security probes: C1 1.0 · C2 1.0 · C3 0.833&lt;br&gt;Grounding: C1 1.0 · C2 0.979 (5 genuine head-arithmetic flags) · C3 0.0&lt;br&gt;Cost per question: C2 ≈ $0.075 · median latency 10.4 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;fontSize=12;align=left;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="660" y="620" width="960" height="200" as="geometry" />
        </mxCell>
        <mxCell id="9 e17" value="&lt;b&gt;Risk model (out of sample)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;train to 2026-04-02 · test Apr–Sep 2026&lt;br&gt;AUC 0.668 vs 0.567 persistence baseline · Brier 0.233 vs 0.408&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;fontSize=12;align=left;verticalAlign=middle;arcSize=8;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="30" y="650" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="9 e33" value="&lt;b&gt;Threats to validity&lt;/b&gt;&lt;br&gt;Data, signals and questions share an author → compare conditions on identical items, then re-run on a real pilot extract with staff-written questions. LLM runs vary (an earlier C2 run scored 28/28) → n ≥ 3 runs with variance." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="30" y="790" width="560" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
