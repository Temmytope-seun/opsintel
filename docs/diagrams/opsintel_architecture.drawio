        <mxCell id="8 d48" value="Pilot mapping: SQLite → PostgreSQL 16 · authorizer → read-only DB role with column privileges + statement_timeout · TF-IDF → pgvector · X-User header → Entra ID OIDC group claims · CSV drops → ServiceNow Table API incremental by sys_updated_on." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontSize=11;align=left;verticalAlign=top;fontColor=#444444;" parent="1" vertex="1">
