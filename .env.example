# Copy to .env (git-ignored) and fill in. Never commit real values.
# ServiceNow instance
SN_INSTANCE=https://devXXXXX.service-now.com
# Option A (preferred): OAuth 2.0 client credentials - used when SN_CLIENT_ID is set
SN_CLIENT_ID=
SN_CLIENT_SECRET=
# Option B: basic auth for a read-only integration user
SN_USERNAME=opsintel.integration
SN_PASSWORD=
# Optional: Claude engine
ANTHROPIC_API_KEY=
